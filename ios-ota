#!/bin/bash
# Over-the-air installs of your own iOS apps on your own iPhone, through Tailscale. One server for every project.
#
#   ios-ota publish [--scheme S] [--project P.xcodeproj | --workspace W.xcworkspace] [-- BUILD_SETTING=value ...]
#       From a project folder: archive it, export it signed for development, and publish it. Prints the install page.
#       The app's name, bundle id and version come from the build; the signing team from Xcode's build settings.
#       Anything after -- is passed to xcodebuild (say CURRENT_PROJECT_VERSION=123).
#   ios-ota publish --ipa App.ipa
#       Publish an app file built some other way (it must be signed for development with your team).
#   ios-ota setup        Build and install the menu bar app (the server) and share it on the tailnet.
#   ios-ota status       Is the server running and shared, and which apps are published.
#   ios-ota uninstall    Quit and remove the menu bar app and the tailnet share (published builds stay on disk).
#
# On the iPhone, with Tailscale on: https://<this Mac>.<tailnet>.ts.net:8444/ lists every app; each app has its own page
# (/<app key>/) that always offers its newest build. Tap Install. Only devices registered to the signing team can install.
# The app key is the first 12 hex digits of the SHA-256 of the bundle id, so addresses do not show the bundle id.
#
# How it works: builds go in ~/Library/Application Support/iOS-OTA/<app key>/<random id>/ (App.ipa, manifest.plist, the
# icon and build.json); the newest five builds of each app are kept. The menu bar app "iOS OTA" (MenuBar/) serves that
# folder on 127.0.0.1:8445, makes the pages (one per app and one listing them all) for each request from the builds, and
# shows what is published; `tailscale serve` passes it on over HTTPS at port 8444, to the tailnet only. Publishing starts the app
# if it is not running, and the app starts at login.

set -euo pipefail

PORT=8444                    # on the tailnet (HTTPS)
LOCAL=8445                   # the menu bar app's server, behind it
ROOT="$HOME/Library/Application Support/iOS-OTA"
KEEP=5
APP="$HOME/Applications/iOS OTA.app"
HERE=$(cd "$(dirname "$(readlink -f "$0")")" && pwd)
TS=$(command -v tailscale || echo /Applications/Tailscale.app/Contents/MacOS/Tailscale)

die() { echo "ios-ota: $*" >&2; exit 1; }
host() { "$TS" status --json | python3 -c 'import json,sys; print(json.load(sys.stdin)["Self"]["DNSName"].rstrip("."))'; }
shared() { "$TS" serve status --json 2>/dev/null | python3 -c "import json,sys; sys.exit(0 if '$PORT' in json.load(sys.stdin).get('TCP',{}) else 1)"; }
listening() { lsof -nP -iTCP:"$LOCAL" -sTCP:LISTEN >/dev/null 2>&1; }
plist() { /usr/libexec/PlistBuddy -c "Print :$1" "$2" 2>/dev/null; }

# Starts the menu bar app (the server) if it is not running, and makes sure the tailnet share is on.
ensure_server() {
  if ! listening; then
    [ -d "$APP" ] || die "the menu bar app is not installed; run: ios-ota setup"
    open -g "$APP"
    for _ in $(seq 1 30); do listening && break; sleep 0.2; done
    listening || die "the menu bar app did not start serving on 127.0.0.1:$LOCAL"
  fi
  shared || "$TS" serve --bg --https="$PORT" "http://127.0.0.1:$LOCAL" >/dev/null
}

# MARK: setup

setup() {
  mkdir -p "$ROOT" "$HOME/Applications" "$HOME/.local/bin"
  # The Python server and its login item, from before the menu bar app took over.
  launchctl bootout "gui/$(id -u)/com.appler.ios-ota" 2>/dev/null || true
  rm -f "$HOME/Library/LaunchAgents/com.appler.ios-ota.plist"

  echo "Building the menu bar app..."
  local work; work=$(mktemp -d "${TMPDIR:-/tmp}/ios-ota-app.XXXXXX")
  (cd "$HERE/MenuBar" && xcodegen generate -q && xcodebuild -project iOSOTA.xcodeproj -scheme iOSOTA -configuration Release \
     -derivedDataPath "$work" build -quiet)
  osascript -e 'quit app "iOS OTA"' 2>/dev/null || true
  sleep 1
  rm -rf "$APP"
  cp -R "$work/Build/Products/Release/iOS OTA.app" "$APP"
  rm -rf "$work"
  ln -sf "$HERE/ios-ota" "$HOME/.local/bin/ios-ota"
  ensure_server
  echo "Installed $APP; serving https://$(host):$PORT/"
}

uninstall() {
  osascript -e 'quit app "iOS OTA"' 2>/dev/null || true
  rm -rf "$APP"
  shared && "$TS" serve --https="$PORT" off >/dev/null || true
  echo "Removed the menu bar app and the tailnet share. Builds are still in $ROOT."
}

status() {
  if listening; then echo "server: running (iOS OTA, 127.0.0.1:$LOCAL)"; else echo "server: not running (open \"$APP\", or ios-ota setup)"; fi
  if shared; then echo "shared: https://$(host):$PORT/"; else echo "shared: no"; fi
  python3 - "$ROOT" <<'PY'
import json, os, sys
root = sys.argv[1]
for bundle in sorted(os.listdir(root)) if os.path.isdir(root) else []:
    found = []
    for bid in os.listdir(os.path.join(root, bundle)) if os.path.isdir(os.path.join(root, bundle)) else []:
        try: found.append(json.load(open(os.path.join(root, bundle, bid, "build.json"))))
        except (OSError, ValueError): pass
    if found:
        b = max(found, key=lambda x: x.get("time", ""))
        print(f"  {b['title']} {b['version']} ({b['build']}), {len(found)} build(s), newest {b['time']}")
PY
}

# MARK: publish

publish() {
  local scheme="" project="" workspace="" ipa="" extra=()
  while [ $# -gt 0 ]; do
    case "$1" in
      --scheme) scheme="$2"; shift 2 ;;
      --project) project="$2"; shift 2 ;;
      --workspace) workspace="$2"; shift 2 ;;
      --ipa) ipa="$2"; shift 2 ;;
      --) shift; extra=("$@"); break ;;
      *) die "unknown option $1 (see the top of $HERE/ios-ota)" ;;
    esac
  done

  local work; work=$(mktemp -d "${TMPDIR:-/tmp}/ios-ota.XXXXXX")
  trap "rm -rf '$work'" EXIT                                   # expanded now: \$work is gone once publish returns
  # Where the code came from. `changed` is when it last changed: the commit's date, or now when there are uncommitted
  # changes (or no commit at all), since those are newer than any commit. It never fetches or pulls: it builds this checkout.
  local commit="" from="" changed=""
  if git rev-parse --git-dir >/dev/null 2>&1; then
    commit="$(git rev-parse --abbrev-ref HEAD) @ $(git rev-parse --short HEAD)"
    from=$(git rev-parse --show-toplevel)
    if git diff --quiet HEAD 2>/dev/null; then changed=$(git log -1 --format=%cI)
    else commit="$commit, with uncommitted changes"; fi
  fi

  local appinfo
  if [ -n "$ipa" ]; then
    [ -f "$ipa" ] || die "no such file: $ipa"
    cp "$ipa" "$work/App.ipa"
    (cd "$work" && { unzip -qo App.ipa 'Payload/*.app/Info.plist' 'Payload/*.app/*.png' 2>/dev/null || unzip -qo App.ipa 'Payload/*.app/Info.plist'; })
    appinfo=$(ls "$work"/Payload/*.app/Info.plist | head -1)
    [ -n "$commit" ] || commit="$(basename "$ipa")"
  else
    build_app "$work" "$scheme" "$project" "$workspace" ${extra[@]+"${extra[@]}"}
    appinfo=$(ls "$work"/App.xcarchive/Products/Applications/*.app/Info.plist | head -1)
  fi

  local bundle version build title
  bundle=$(plist CFBundleIdentifier "$appinfo")
  version=$(plist CFBundleShortVersionString "$appinfo" || echo "?")
  build=$(plist CFBundleVersion "$appinfo" || echo "?")
  title=$(plist CFBundleDisplayName "$appinfo" || plist CFBundleName "$appinfo" || echo "$bundle")
  [ -n "$bundle" ] || die "could not read the app's bundle id"

  local base="https://$(host):$PORT"
  local key; key=$(app_key "$bundle")
  local id; id=$(date +%Y%m%d-%H%M%S)-$(openssl rand -hex 6)      # a fresh, unguessable folder per build
  local dir="$ROOT/$key/$id"
  mkdir -p "$dir"
  cp "$work/App.ipa" "$dir/App.ipa"
  local icon=""; save_icon "$(dirname "$appinfo")" "$dir/icon.png" && icon="icon.png"

  python3 - "$dir" "$base/$key/$id" "$id" "$bundle" "$title" "$version" "$build" "$commit" "$from" "$icon" "$changed" <<'PY'
import json, os, plistlib, sys
from datetime import datetime, timezone
d, url, bid, bundle, title, version, build, commit, project, icon, changed = sys.argv[1:]
now = datetime.now(timezone.utc)
if changed:
    changed = datetime.fromisoformat(changed).astimezone(timezone.utc).isoformat(timespec="seconds")
assets = [{"kind": "software-package", "url": f"{url}/App.ipa"}]
if icon:   # shown on the iPhone while the app installs
    assets += [{"kind": "display-image", "url": f"{url}/{icon}"}, {"kind": "full-size-image", "url": f"{url}/{icon}"}]
with open(os.path.join(d, "manifest.plist"), "wb") as f:
    plistlib.dump({"items": [{
        "assets": assets,
        "metadata": {"bundle-identifier": bundle, "bundle-version": version, "kind": "software", "title": title},
    }]}, f)
info = {"id": bid, "bundle": bundle, "title": title, "version": version, "build": build,
        "time": now.isoformat(timespec="seconds"), "changed": changed or now.isoformat(timespec="seconds"),
        "commit": commit, "project": project,
        "size": os.path.getsize(os.path.join(d, "App.ipa")), "manifest": f"{url}/manifest.plist", "icon": icon}
with open(os.path.join(d, "build.json"), "w") as f:
    json.dump(info, f, indent=1)     # written last: a build counts once this file exists
PY

  # The newest builds of this app only; older links stop working with their files.
  ls -1d "$ROOT/$key"/*/ 2>/dev/null | sort -r | tail -n +$((KEEP + 1)) | while read -r old; do rm -rf "$old"; done
  ensure_server          # the pages come from the builds folder, so the new build shows at once

  echo
  echo "$title $version ($build) is ready. On the iPhone (Tailscale on), open:"
  echo "  $base/$key/"
  if command -v qrencode >/dev/null; then qrencode -t ANSIUTF8 -m 1 "$base/$key/"; fi
}

# An app's folder and address: the first 12 hex digits of the SHA-256 of its bundle id (the menu bar app works it out the
# same way), so the bundle id is not in any address.
app_key() { printf '%s' "$1" | shasum -a 256 | cut -c1-12; }

# The app's icon, as a standard PNG at $2: the largest icon image in the app at $1. iOS keeps these in its own PNG variant
# (CgBI), which browsers cannot show; sips reads it and writes a normal PNG. False when the app has no icon images.
save_icon() {
  local app="$1" out="$2" best="" size=0 w f
  for f in "$app"/AppIcon*.png "$app"/Icon*.png; do
    [ -f "$f" ] || continue
    w=$(sips -g pixelWidth "$f" 2>/dev/null | awk '/pixelWidth/ { print $2 }')
    if [ "${w:-0}" -gt "$size" ]; then size=$w; best=$f; fi
  done
  [ -n "$best" ] && sips -s format png "$best" --out "$out" >/dev/null 2>&1
}

# Archives and exports the project in the current folder into $1/App.ipa (and $1/App.xcarchive).
build_app() {
  local work="$1" scheme="$2" project="$3" workspace="$4"; shift 4
  local extra=("$@")
  # The project: given, or the one workspace / project here (generated first from project.yml when only that exists).
  if [ -z "$project$workspace" ]; then
    if [ -f project.yml ] && ! ls -d *.xcodeproj >/dev/null 2>&1; then xcodegen generate -q; fi
    local ws=( $(ls -d *.xcworkspace 2>/dev/null || true) ) pr=( $(ls -d *.xcodeproj 2>/dev/null || true) )
    if [ ${#ws[@]} -eq 1 ]; then workspace="${ws[0]}"
    elif [ ${#pr[@]} -eq 1 ]; then project="${pr[0]}"
    else die "found ${#ws[@]} workspaces and ${#pr[@]} projects here; pass --workspace or --project"; fi
  fi
  local where=(); if [ -n "$workspace" ]; then where=(-workspace "$workspace"); else where=(-project "$project"); fi

  # The scheme: given, or the only one.
  if [ -z "$scheme" ]; then
    local schemes
    schemes=$(xcodebuild "${where[@]}" -list -json 2>/dev/null | python3 -c 'import json,sys; d=json.load(sys.stdin); print("\n".join((d.get("project") or d.get("workspace"))["schemes"]))')
    [ "$(echo "$schemes" | grep -c .)" -eq 1 ] || die "pass --scheme, one of: $(echo $schemes)"
    scheme="$schemes"
  fi

  local team
  team=$(xcodebuild "${where[@]}" -scheme "$scheme" -configuration Release -showBuildSettings ${extra[@]+"${extra[@]}"} 2>/dev/null \
         | awk -F' = ' '/ DEVELOPMENT_TEAM = / { print $2; exit }')
  [ -n "$team" ] || die "no DEVELOPMENT_TEAM in the build settings of $scheme"

  # Xcode's intermediate files (which include a built copy of the app) go in $work, which is deleted afterwards, so no
  # build is left on this Mac for it to launch or index. Downloaded Swift packages are kept between publishes, per project.
  local packages="$HOME/Library/Caches/ios-ota/packages/$(printf '%s' "$PWD" | shasum -a 256 | cut -c1-12)"
  mkdir -p "$packages"
  echo "Building $scheme..."
  xcodebuild "${where[@]}" -scheme "$scheme" -configuration Release -destination generic/platform=iOS \
    -archivePath "$work/App.xcarchive" -derivedDataPath "$work/DerivedData" -clonedSourcePackagesDirPath "$packages" \
    -allowProvisioningUpdates ${extra[@]+"${extra[@]}"} archive -quiet

  cat > "$work/ExportOptions.plist" <<PLIST
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>method</key><string>debugging</string>
  <key>teamID</key><string>$team</string>
  <key>signingStyle</key><string>automatic</string>
  <key>thinning</key><string>&lt;none&gt;</string>
</dict></plist>
PLIST
  xcodebuild -exportArchive -archivePath "$work/App.xcarchive" -exportOptionsPlist "$work/ExportOptions.plist" \
    -exportPath "$work/export" -allowProvisioningUpdates -quiet
  cp "$(ls "$work"/export/*.ipa | head -1)" "$work/App.ipa"
}

case "${1:-}" in
  publish) shift; publish "$@" ;;
  setup) setup ;;
  status) status ;;
  uninstall) uninstall ;;
  *) sed -n '2,14p' "$0" | sed 's/^# \{0,1\}//'; exit 1 ;;
esac
